# 环境文件的模板: 复制成 .env 后按需取消注释.
#
# 生效规则有三条:
#   1. 已存在的真实环境变量优先——临时换一个值不必改这个文件.
#   2. 键名一律 QUANT_ 前缀; 别的名字会记一条 warning 并被忽略.
#   3. 等号右侧的成对引号会被剥掉, 取值里的 `#` 不算注释起点 (口令里带 # 不会被截断).
#
# 文件不存在也没关系, 全部走下面的默认值.

# ── 初始管理员 ──────────────────────────────────────────────
# 只在"库里还没有管理员账号"时用得上; 空串等同于未设置 (不是"口令为空").
# 不给值而库又是空的, 启动会直接抛 RuntimeError, 这是有意为之.
#QUANT_INITIAL_ADMIN_PASSWORD=
#QUANT_INITIAL_ADMIN_USERNAME=admin

# ── 库与目录 ────────────────────────────────────────────────
# 默认 backend/data/catalog.db (已被 .gitignore 覆盖)
#QUANT_DATABASE_URL=sqlite+aiosqlite:///D:/Gitee/QuantPlatform/backend/data/catalog.db
# 默认 <仓根>/runs
#QUANT_RUNS_ROOT=D:/Gitee/QuantPlatform/runs
# 默认 <仓根>/users
#QUANT_USER_LIBRARY_ROOT=D:/Gitee/QuantPlatform/users

# ── 引擎与行情 ──────────────────────────────────────────────
# 默认 ../QuantTrading/bin/Release; 换机器必须改
#
# 引擎**不复制进本仓**: 平台按这个路径就地引用, 且会把**提交那一刻**读到的引擎标识冻进
# 每一轮 (Runs.EngineVersion, 详情页与 /api/health 各显示一处). 故换版请按目录留档而不是
# 原地覆盖, 例如:
#     D:/Gitee/QuantTrading/bin/Release-2026.09
#     D:/Gitee/QuantTrading/bin/Release-2026.11
# 再把这个变量指过去并重启后端——历史轮记的仍是它当初那一版, 新旧数字才分得开.
#
# 标识优先取 <引擎根>/engine-version.txt 的首个非空行 (QuantTrading 侧产出, 本仓不生成);
# 文件不在时退化为 .pyd 与三个运行时 DLL 的内容摘要 "sha256:<12 位>"; 两者都取不到则为空串.
# 摘要与版本号**不可比**——前者变了只说明那四个文件变了, 不说明变了什么.
#QUANT_ENGINE_ROOT=D:/Gitee/QuantTrading/bin/Release
# 默认 D:/MdBaoStock; 必须是绝对路径 (引擎相对作业目录解析读路径, 相对值不报错但找不到数据)
#QUANT_MARKET_DATA_ROOT=D:/MdBaoStock
# 默认 <引擎根>/Sessions.json, 同样是绝对路径
#QUANT_SESSION_FILE_PATH=D:/Gitee/QuantTrading/bin/Release/Sessions.json
# 默认 <引擎根>/BackTestInit.db; 本机没有它, 费用三项因此恒为 0
#QUANT_SEED_DATABASE_PATH=D:/Gitee/QuantTrading/bin/Release/BackTestInit.db

# ── 服务与调度 ──────────────────────────────────────────────
# 默认 127.0.0.1:8000
#QUANT_HTTP_HOST=127.0.0.1
#QUANT_HTTP_PORT=8000
# 默认 1; 单实例是调度器的硬前提, 这个值调大只是并发跑几轮, 仍只有一个后端进程
#QUANT_MAX_CONCURRENT_RUNS=1
# 单轮时限 (秒), 默认 1800
#QUANT_RUN_TIMEOUT_SECONDS=1800
# 令牌有效期 (分钟), 默认 1440
#QUANT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 输出尾部截断阈值 (字节), 默认 8192
#QUANT_MAXIMUM_OUTPUT_TAIL_BYTES=8192

# ── 仅测试用 ────────────────────────────────────────────────
# 真引擎验收 (pytest -m real_engine) 用它定位两个仓之外的输入
#QUANT_REAL_ENGINE_ROOT=D:/Gitee/QuantTrading/bin/Release
#QUANT_REAL_MARKET_DATA_ROOT=D:/MdBaoStock
